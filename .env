GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=myPass!@123
GRAFANA_PORT=4007
GF_SERVER_ROOT_URL='http://localhost:4007'

PROMETHEUS_RETENTION=15d

# Prometheus
PROMETHEUS_CPU_LIMIT=1.0
PROMETHEUS_MEM_LIMIT=1G
PROMETHEUS_CPU_RESERVE=0.5
PROMETHEUS_MEM_RESERVE=512M

# Grafana
GRAFANA_CPU_LIMIT=0.5
GRAFANA_MEM_LIMIT=512M
GRAFANA_CPU_RESERVE=0.2
GRAFANA_MEM_RESERVE=256M

# Node Exporter
NODE_EXPORTER_CPU_LIMIT=0.2
NODE_EXPORTER_MEM_LIMIT=256M
NODE_EXPORTER_CPU_RESERVE=0.1
NODE_EXPORTER_MEM_RESERVE=128M

# cAdvisor
CADVISOR_CPU_LIMIT=0.4
CADVISOR_MEM_LIMIT=512M
CADVISOR_CPU_RESERVE=0.2
CADVISOR_MEM_RESERVE=256M

PROMETHEUS_SCRAPE_INTERVAL=30s
PROMETHEUS_SCRAPE_TIMEOUT=10s
PROMETHEUS_EVAL_INTERVAL=30s

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3

LOKI_PORT=3100
LOKI_CPU_LIMIT=0.5
LOKI_MEM_LIMIT=512M
LOKI_CPU_RESERVE=0.2
LOKI_MEM_RESERVE=256M

# Promtail
PROMTAIL_CPU_LIMIT=0.2
PROMTAIL_MEM_LIMIT=256M
PROMTAIL_CPU_RESERVE=0.1
PROMTAIL_MEM_RESERVE=128M
